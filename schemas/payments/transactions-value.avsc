{
  "type": "record",
  "name": "Transaction",
  "namespace": "com.bootcamp.payments",
  "fields": [
    {
      "name": "transaction_id",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      }
    },
    {
      "name": "account_id",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "confluent:tags": [
        "FIN"
      ]
    },
    {
      "name": "card_id",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "confluent:tags": [
        "PCI"
      ]
    },
    {
      "name": "merchant_id",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      }
    },
    {
      "name": "channel",
      "type": "string"
    },
    {
      "name": "amount",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 15,
        "scale": 2
      },
      "confluent:tags": [
        "FIN"
      ]
    },
    {
      "name": "currency",
      "type": "string",
      "default": "BRL"
    },
    {
      "name": "mcc",
      "type": "string"
    },
    {
      "name": "transaction_state",
      "type": "string"
    },
    {
      "name": "status",
      "type": "string"
    },
    {
      "name": "decline_reason",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "created_at",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "authorized_at",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null
    },
    {
      "name": "settled_at",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null
    }
  ]
}